# Cloudflare Configuration
# Copy this file to .env for local development

# R2 Bucket Configuration
R2_BUCKET_NAME=static-robray-net
ASSETS_URL=https://static.robray.net

# Worker Configuration
WORKER_NAME=des4800-robray-net-site-production

# Site Configuration
SITE_URL=https://des4800.robray.net

# Cloudflare API credentials
# Required for cache purge (purge:cache) and R2 image manifest rebuild (update:images-manifest:r2)
# API token: https://dash.cloudflare.com/profile/api-tokens
#   Needs "Cache Purge" and "R2 Object Read" permissions
# Account ID + Zone ID: found on the right sidebar of your domain in the Cloudflare dashboard
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

