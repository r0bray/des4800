---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'DES4800 Project - Hosted on Cloudflare Workers' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-container">
        <div class="footer-column">
          <h3>Navigation</h3>
          <nav class="footer-nav">
            <a href="/">Home</a>
            <a href="/plasticity/">Plasticity</a>
            <a href="https://csusb.instructure.com/courses/59832" target="_blank" rel="noopener noreferrer" class="external-link">
              Canvas
              <svg class="external-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z" />
                <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z" />
              </svg>
            </a>
          </nav>
        </div>
        
        <div class="footer-column">
          <h3>Projects</h3>
          <nav class="footer-nav">
            <a href="/plasticity/">Plasticity Tutorials</a>
            <a href="#">3D Modeling</a>
            <a href="#">Product Design</a>
            <a href="#">Portfolio</a>
          </nav>
        </div>
        
        <div class="footer-column">
          <h3>Contact</h3>
          <nav class="footer-nav">
            <a href="mailto:des4800@csusb.edu">Email</a>
            <a href="#">Office Hours</a>
            <a href="#">Resources</a>
          </nav>
        </div>
      </div>
      
      <div class="footer-bottom">
        <p>Built with Astro • Hosted on Cloudflare Workers • Assets on R2</p>
      </div>
    </footer>
  </body>
</html>

