---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'DES4800 Project - Hosted on Cloudflare Workers' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-container">
        <div class="footer-column">
          <h3>Navigation</h3>
          <nav class="footer-nav">
            <a href="/">Home</a>
            <a href="https://csusb.instructure.com/courses/59832" target="_blank" rel="noopener noreferrer" class="external-link">
              Canvas
              <svg class="external-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z" />
                <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z" />
              </svg>
            </a>
            <a href="/plasticity/">Plasticity Tutorials</a>
            <a href="#">Student Portfolio</a>
            <a href="#">Links & Resources</a>
          </nav>
        </div>
        
        <div class="footer-column">
          <h3>Projects</h3>
          <nav class="footer-nav">
            <a href="/bauhaus-chess-set/">1924 Bauhaus Chess Set</a>
          </nav>
        </div>
        
        <div class="footer-column">
          <h3>Contact</h3>
          <nav class="footer-nav">
            <a href="mailto:rob.ray@csusb.edu" class="icon-link">
              <svg class="link-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
              </svg>
              rob.ray@csusb.edu
            </a>
            <a href="https://github.com/r0bray/" target="_blank" rel="noopener noreferrer" class="icon-link">
              <svg class="link-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              GitHub
            </a>
            <a href="https://www.csusb.edu/art" target="_blank" rel="noopener noreferrer" class="icon-link">
              <svg class="link-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <!-- Coyote sitting profile -->
                <path d="M8 4 L6 2 L7 6 L5 7 L7 9 L6 12 C6 12 7 11 8 12 C8 12 9 11 10 12 L12 10 L14 12 C14 12 15 11 16 12 C17 11 18 12 18 12 L17 9 L19 7 L17 6 L18 2 L16 4 L12 2 Z"/>
                <ellipse cx="12" cy="15" rx="7" ry="5"/>
                <path d="M18 14 Q21 13 22 16"/>
                <rect x="9" y="19" width="1.5" height="3" rx="0.5"/>
                <rect x="13.5" y="19" width="1.5" height="3" rx="0.5"/>
              </svg>
              CSUSB Art & Design
            </a>
            <a href="http://robray.net" target="_blank" rel="noopener noreferrer" class="icon-link">
              <svg class="link-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <!-- Head -->
                <rect x="8" y="6" width="8" height="7" rx="1"/>
                <!-- Eyes -->
                <rect x="10" y="9" width="1.5" height="2" rx="0.5"/>
                <rect x="12.5" y="9" width="1.5" height="2" rx="0.5"/>
                <!-- Antenna -->
                <line x1="12" y1="6" x2="12" y2="3" stroke="currentColor" stroke-width="1"/>
                <circle cx="12" cy="3" r="1"/>
                <!-- Body -->
                <rect x="9" y="13" width="6" height="5" rx="0.5"/>
                <!-- Control panel -->
                <circle cx="11" cy="15.5" r="0.7"/>
                <circle cx="13" cy="15.5" r="0.7"/>
                <!-- Arms -->
                <rect x="6" y="14" width="3" height="1.5" rx="0.75"/>
                <rect x="15" y="14" width="3" height="1.5" rx="0.75"/>
                <!-- Legs -->
                <rect x="9.5" y="18" width="2" height="4" rx="0.5"/>
                <rect x="12.5" y="18" width="2" height="4" rx="0.5"/>
              </svg>
              robray.net
            </a>
          </nav>
        </div>
      </div>
      
      <div class="footer-bottom">
        <p>Built with Astro • Hosted on Cloudflare Workers • Assets on R2</p>
      </div>
    </footer>
  </body>
</html>

