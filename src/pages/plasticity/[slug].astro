---
import Layout from '../../layouts/Layout.astro';
import { getEntry } from 'astro:content';

// Get the slug from the URL
const { slug } = Astro.params;

// Fetch the post by slug
const post = await getEntry('plasticity', slug as string);

// Handle 404 if post doesn't exist
if (!post) {
  return Astro.redirect('/404');
}

const { Content } = await post.render();
---

<Layout title={`${post.data.title} - Plasticity - DES4800`}>
  <article class="post-detail">
    <header class="post-header">
      <a href="/plasticity/" class="back-link">← Back to Plasticity</a>
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={post.data.publishDate.toISOString()}>
          {post.data.publishDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
        </time>
        {post.data.author && (
          <span class="post-author">by {post.data.author}</span>
        )}
      </div>
      {post.data.tags && (
        <div class="post-tags">
          {post.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <div class="post-content">
      <Content />
    </div>
  </article>
</Layout>

