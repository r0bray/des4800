---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const prerender = true;

export const getStaticPaths = (async () => {
  const posts = await getCollection('plasticity');
  return posts.map((post) => ({
    params: { slug: post.id },
  }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const post = await getEntry('plasticity', slug!);

if (!post) {
  return Astro.redirect('/404');
}

const { Content } = await render(post);
const lastModified = post.data.lastModified ?? new Date(0);
---

<Layout title={`${post.data.title} - Plasticity - DES4800`}>
  <article class="post-detail">
    <header class="post-header">
      <a href="/plasticity/" class="back-link">← Back to Plasticity</a>
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={lastModified.toISOString()}>
          Last updated: {lastModified.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
        </time>
        {post.data.author && (
          <span class="post-author">by {post.data.author}</span>
        )}
      </div>
    </header>

    <div class="post-content">
      <Content />
    </div>
  </article>
</Layout>
