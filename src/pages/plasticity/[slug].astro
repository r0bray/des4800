---
import Layout from '../../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import { statSync } from 'node:fs';
import { join } from 'node:path';

// Get the slug from the URL
const { slug } = Astro.params;

// Fetch the post by slug
const post = await getEntry('plasticity', slug as string);

// Handle 404 if post doesn't exist
if (!post) {
  return Astro.redirect('/404');
}

// Get file modification date
const filePath = join(process.cwd(), 'src', 'content', 'plasticity', `${slug}.md`);
const stats = statSync(filePath);
const lastModified = stats.mtime;

const { Content } = await post.render();
---

<Layout title={`${post.data.title} - Plasticity - DES4800`}>
  <article class="post-detail">
    <header class="post-header">
      <a href="/plasticity/" class="back-link">← Back to Plasticity</a>
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={lastModified.toISOString()}>
          Last updated: {lastModified.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
        </time>
        {post.data.author && (
          <span class="post-author">by {post.data.author}</span>
        )}
      </div>
    </header>

    <div class="post-content">
      <Content />
    </div>
  </article>
</Layout>

