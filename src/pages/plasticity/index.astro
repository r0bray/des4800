---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const plasticityPosts = await getCollection('plasticity');

const sortedPosts = [...plasticityPosts].sort(
  (a, b) =>
    (b.data.lastModified?.getTime() ?? 0) - (a.data.lastModified?.getTime() ?? 0),
);
---

<Layout title="Plasticity - DES4800">
  <div class="page-header">
    <h1>Plasticity</h1>
    <p>3D modeling tutorials, tips, and techniques for product design.</p>
  </div>

  <div class="posts-grid">
    {sortedPosts.map((post) => (
      <article class="post-card">
        <div class="post-card-content">
          <h2 class="post-title">
            <a href={`/plasticity/${post.id}/`}>{post.data.title}</a>
          </h2>
          <p class="post-date">
            Last updated: {(post.data.lastModified ?? new Date(0)).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </p>
          <p class="post-description">{post.data.description}</p>
        </div>
        <div class="post-card-footer">
          <a href={`/plasticity/${post.id}/`} class="read-more">
            Read More →
          </a>
        </div>
      </article>
    ))}
  </div>
</Layout>
