---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { statSync } from 'node:fs';
import { join } from 'node:path';

const plasticityPosts = await getCollection('plasticity');

// Get file modification dates and attach to posts
const postsWithDates = plasticityPosts.map((post) => {
  const filePath = join(process.cwd(), 'src', 'content', 'plasticity', `${post.slug}.md`);
  const stats = statSync(filePath);
  return {
    ...post,
    lastModified: stats.mtime
  };
});

// Sort posts by last modified date (newest first)
const sortedPosts = postsWithDates.sort((a, b) => 
  b.lastModified.getTime() - a.lastModified.getTime()
);
---

<Layout title="Plasticity - DES4800">
  <div class="page-header">
    <h1>Plasticity</h1>
    <p>3D modeling tutorials, tips, and techniques for product design.</p>
  </div>

  <div class="posts-grid">
    {sortedPosts.map((post) => (
      <article class="post-card">
        <div class="post-card-content">
          <h2 class="post-title">
            <a href={`/plasticity/${post.slug}/`}>{post.data.title}</a>
          </h2>
          <p class="post-date">
            Last updated: {post.lastModified.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </p>
          <p class="post-description">{post.data.description}</p>
        </div>
        <div class="post-card-footer">
          <a href={`/plasticity/${post.slug}/`} class="read-more">
            Read More →
          </a>
        </div>
      </article>
    ))}
  </div>
</Layout>

