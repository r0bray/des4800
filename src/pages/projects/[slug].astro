---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const prerender = true;

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: any;
}

const { project } = Astro.props as Props;

// Only render published projects (unless in dev)
if (project.data.status === 'draft' && !import.meta.env.DEV) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const { Content } = await render(project);
---

<Layout
  title={`${project.data.title} - Projects - DES4800`}
  description={project.data.description}
>
  <article class="post-detail">
    <header class="post-header">
      <a href="/projects/" class="back-link">← Back to Projects</a>
      <div class="post-header-title-row">
        <h1>{project.data.title}</h1>
        {project.data.status === 'draft' && import.meta.env.DEV && (
          <span class="status-badge status-badge--draft">Draft</span>
        )}
      </div>
    </header>

    {project.data.heroImage && (
      <figure class="post-hero">
        <img
          src={project.data.heroImage}
          alt={project.data.heroImageAlt ?? project.data.title}
          loading="eager"
          decoding="async"
        />
        {project.data.heroImageCaption && (
          <figcaption set:html={project.data.heroImageCaption} />
        )}
      </figure>
    )}

    <div class="post-content">
      <Content />
    </div>
  </article>
</Layout>
