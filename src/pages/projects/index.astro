---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const allProjects = await getCollection('projects');
const publishedProjects = allProjects.filter((p) => p.data.status === 'published' || import.meta.env.DEV);
const showDraftBadge = import.meta.env.DEV;
---

<Layout
  title="Projects - DES4800"
  description="Project walkthroughs and case studies in product design and soft goods."
>
  <div class="page-header page-header--left">
    <h1>Projects</h1>
    <p>
      Complete project walkthroughs that bring together the skills, tools, and materials from the course. Each project is a case study in problem-solving, decision-making, and execution in product design and soft goods.
    </p>
  </div>

  <section class="content-section" aria-labelledby="featured-projects">
    <div class="content-section-header">
      <h2 id="featured-projects">Featured Projects</h2>
      <p>Step-by-step guides and documentation of course projects and design explorations.</p>
    </div>
    {publishedProjects.length > 0 ? (
      <div class="posts-grid">
        {publishedProjects.map((project) => (
          <article class="post-card">
            <a
              href={`/projects/${project.data.slug}/`}
              class:list={['post-card-media', { 'post-card-media--has-image': project.data.heroImage }]}
              aria-label={project.data.heroImage ? project.data.title : `${project.data.title} image placeholder`}
            >
              {project.data.heroImage ? (
                <img src={project.data.heroImage} alt="" loading="lazy" />
              ) : (
                <span class="post-card-media-label">Image coming soon</span>
              )}
            </a>
            <div class="post-card-content">
              <h3 class="post-title">
                <a href={`/projects/${project.data.slug}/`}>
                  {project.data.title}
                  {showDraftBadge && project.data.status === 'draft' && (
                    <span class="status-badge status-badge--draft">Draft</span>
                  )}
                </a>
              </h3>
              <p class="post-description">{project.data.description}</p>
            </div>
            <div class="post-card-footer">
              <a href={`/projects/${project.data.slug}/`} class="read-more">
                View project →
              </a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="content-section-empty">No published projects yet.</p>
    )}
  </section>
</Layout>
